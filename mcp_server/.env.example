# Copy this file to `.env` (gitignored) and fill in your real values.
# Production reads the same variables from Google Secret Manager via Cloud Run.

# --- Google Maps API key (Phase 1, required) ---
GOOGLE_MAPS_API_KEY=YOUR_KEY

# --- OAuth (Phase 2+, optional locally) ---
# Create an OAuth 2.0 Client ID in GCP Credentials (Application type: Web
# application; Authorized redirect URI: http://localhost:8000/auth/callback).
# Leave both blank to run the server unauthenticated — useful for the
# hermetic test suite, never acceptable for an internet-reachable deploy.
GOOGLE_OAUTH_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-YOUR_SECRET

# --- Optional ---
# Public URL the server is reachable at (used in OAuth metadata + redirect).
# Defaults to http://localhost:8000 for local dev. Set to your Cloud Run URL
# in Phase 3.
# MCP_BASE_URL=http://localhost:8000

# HTTP port for the local FastMCP server. Cloud Run injects PORT itself,
# so leave this commented out unless you want to override the local default.
# PORT=8000
